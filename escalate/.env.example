# Copy to escalate/.env and fill in. Never commit .env.
# Nothing here is needed for tests or `npm run demo`; it only enables the real AI letter reader.
# The CLI reads escalate/.env first, then the repo-root .env, never overwriting a variable already set.

# Naïve API key. VETTA_API_KEY also works.
NAIVE_API_KEY=
# Naïve API base URL (default shown). VETTA_API_BASE_URL also works.
NAIVE_API_BASE_URL=https://api.vetta.sh
# Model for the first read of a decision letter, exactly as `naive models list --human` lists it.
ESCALATE_MODEL=
# Stronger model for the automatic second read of unclear letters.
ESCALATE_ESCALATION_MODEL=
